APP_NAME=EduNest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edunest
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@edunest.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_DEMO=false
PAYMENT_SIM_SECRET=edunest-payment-simulation-dev

# MoMo môi trường thử (CR-260): bộ khóa thử ở developers.momo.vn; để trống thì tắt kênh MoMo.
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
BANK_SIM_SECRET=edunest-bank-simulation-dev
# Thông báo đẩy (CR-262): sinh cặp khóa bằng `php artisan edunest:vapid`. Windows/Laragon cần thêm OPENSSL_CONF trỏ tới extras/ssl/openssl.cnf của PHP.
VAPID_SUBJECT=mailto:no-reply@edunest.test
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# OPENSSL_CONF=C:/laragon/bin/php/php-8.3.30-Win32-vs16-x64/extras/ssl/openssl.cnf

# VietQR (CR-261): bỏ dấu # và điền đủ 4 dòng để QR quét được bằng app ngân hàng; BANK_BIN là mã 6 số của ngân hàng.
# BANK_BIN=970436
# BANK_SIM_BANK=Vietcombank
# BANK_SIM_ACCOUNT=
# BANK_SIM_ACCOUNT_NAME=

REVERB_APP_ID=edunest
REVERB_APP_KEY=doi-khoa-nay
REVERB_APP_SECRET=doi-bi-mat-nay
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Trợ lý AI (CR-255): để trống thì dùng bộ giả lập. Dán khóa Gemini của bạn vào đây.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.6-flash,gemini-3-flash-preview

SUPPORT_HOTLINE="0123 456 789"
